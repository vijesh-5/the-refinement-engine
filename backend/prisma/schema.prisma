generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  plan      UserPlan @default(FREE)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contents      Content[]
  refreshTokens RefreshToken[]
  brandProfiles BrandProfile[]
  topicSuggestions TopicSuggestion[]
  authorityPillars AuthorityPillar[]
  knowledgeDocuments KnowledgeDocument[]
  connectedPlatforms ConnectedPlatform[]

  @@index([email])
  @@map("users")
}

// ─── Connected Platforms (Distribution) ─────────────────────────────────────

enum PlatformName {
  BEAR_BLOG
  X
  REDDIT
}

model ConnectedPlatform {
  id            String       @id @default(uuid())
  userId        String
  platformName  PlatformName
  credentials   Json         // { email?: string, apiKey?: string, ... }
  isActive      Boolean      @default(true)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platformName])
  @@index([userId])
  @@map("connected_platforms")
}

model BrandProfile {
  id              String   @id @default(uuid())
  name            String
  industry        String?
  tone            String   @default("Professional")
  targetAudience  String?  @db.Text
  brandVoice      String?  @db.Text
  bannedWords     String[] @default([])
  keySellingPoints String[] @default([])
  userId          String
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitorInsights CompetitorInsight[]
  personas        BrandPersona[]

  @@index([userId])
  @@map("brand_profiles")
}

model CompetitorInsight {
  id             String   @id @default(uuid())
  brandProfileId String
  url            String
  domain         String
  title          String?
  keyMessages    String[] @default([])
  toneAnalysis   String?  @db.Text
  strengthAreas  String[] @default([])
  weaknessGaps   String[] @default([])
  rawSummary     String?  @db.Text
  lastAnalyzed   DateTime @default(now())
  createdAt      DateTime @default(now())

  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([brandProfileId])
  @@map("competitor_insights")
}

enum UserPlan {
  FREE
  PRO
}

model Content {
  id            String          @id @default(uuid())
  title         String
  body          String          @db.Text
  status        ContentStatus   @default(DRAFT)
  contentType   String          @default("general") // blog, ad, product, general
  inputData     Json?           // Store original input parameters
  generatedOutput Json?         // Store structured AI output
  templateId    String?
  userId        String

  // Strategic metadata (Phase 1 — Growth Infrastructure)
  funnelStage     String?       // "TOFU" | "MOFU" | "BOFU"
  objective       String?       // "traffic" | "leads" | "sales"
  primaryKeyword  String?
  pillarId        String?
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      Template?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  pillar        AuthorityPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  versions      ContentVersion[]
  assets        ContentAsset[]
  publicLinks   PublicLink[]
  performance   ContentPerformance[]
  abVariants    AbVariant[]

  @@index([userId])
  @@index([status])
  @@index([contentType])
  @@index([createdAt])
  @@index([funnelStage])
  @@index([objective])
  @@index([pillarId])
  @@map("contents")
}

model ContentVersion {
  id              String   @id @default(uuid())
  contentId       String
  versionNumber   Int
  body            String   @db.Text
  improvementType String?  // seo, conversion, clarity, etc.
  scores          Json?    // Store scores for this specific version
  
  createdAt       DateTime @default(now())

  content         Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([versionNumber])
  @@map("content_versions")
}

enum ContentStatus {
  DRAFT
  COMPLETE
}

model Template {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @db.Text
  category    String
  prompt      String   @db.Text
  icon        String?
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contents    Content[]

  @@index([category])
  @@index([isActive])
  @@map("templates")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model TopicSuggestion {
  id              String   @id @default(uuid())
  userId          String
  brandProfileId  String?
  sourceTopic     String   // The topic that triggered the suggestions
  suggestions     Json     // String[] of related topic ideas
  contentType     String   @default("blog")

  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("topic_suggestions")
}

// ─── Growth Infrastructure ──────────────────────────────────────────────────

model AuthorityPillar {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contents    Content[]
  clusters    ContentCluster[]

  @@index([userId])
  @@map("authority_pillars")
}

model ContentCluster {
  id        String   @id @default(uuid())
  pillarId  String
  name      String
  keywords  String[] @default([])

  createdAt DateTime @default(now())

  pillar    AuthorityPillar @relation(fields: [pillarId], references: [id], onDelete: Cascade)

  @@index([pillarId])
  @@map("content_clusters")
}

// ─── Phase 11 — Multi-Media Enrichment ─────────────────────────────────────

model ContentAsset {
  id        String   @id @default(uuid())
  contentId String
  type      String   @default("thumbnail") // "thumbnail" | "social" | "other"
  url       String
  prompt    String?  @db.Text             // The prompt used to generate the image

  createdAt DateTime @default(now())

  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@map("content_assets")
}

// ─── Phase 12 — Public Sharing ──────────────────────────────────────────────

model PublicLink {
  id        String   @id @default(uuid())
  contentId String
  slug      String   @unique
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())

  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([contentId])
  @@map("public_links")
}

// ─── Phase 13 — Advanced Analytics ─────────────────────────────────────────

model ContentPerformance {
  id          String   @id @default(uuid())
  contentId   String
  impressions Int      @default(0)
  clicks      Int      @default(0)
  ctr         Float    @default(0)
  avgPosition Float    @default(0)
  date        DateTime

  createdAt   DateTime @default(now())

  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([date])
  @@map("content_performance")
}

model AbVariant {
  id           String   @id @default(uuid())
  contentId    String
  variantLabel String   // "A", "B", "C" or custom label
  contentText  String   @db.Text

  createdAt    DateTime @default(now())

  content      Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@map("ab_variants")
}

// ─── Future-Ready Schema (Inactive) ─────────────────────────────────────────

model KnowledgeDocument {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String   @db.Text
  embedding Json?    // nullable — populated when RAG is activated

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("knowledge_documents")
}

model BrandPersona {
  id              String      @id @default(uuid())
  brandId         String
  name            String
  description     String?     @db.Text
  toneBias        String?     // e.g. "formal", "playful"
  vocabularyBias  String?     // e.g. "technical", "simple"
  active          Boolean     @default(false)  // not injected until active

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  brand           BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@map("brand_personas")
}
