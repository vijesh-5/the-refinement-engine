generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  plan      UserPlan @default(FREE)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contents      Content[]
  refreshTokens RefreshToken[]
  brandProfiles BrandProfile[]

  @@index([email])
  @@map("users")
}

model BrandProfile {
  id              String   @id @default(uuid())
  name            String
  industry        String?
  tone            String   @default("Professional")
  targetAudience  String?  @db.Text
  brandVoice      String?  @db.Text
  bannedWords     String[] @default([])
  keySellingPoints String[] @default([])
  userId          String
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitorInsights CompetitorInsight[]

  @@index([userId])
  @@map("brand_profiles")
}

model CompetitorInsight {
  id             String   @id @default(uuid())
  brandProfileId String
  url            String
  domain         String
  title          String?
  keyMessages    String[] @default([])
  toneAnalysis   String?  @db.Text
  strengthAreas  String[] @default([])
  weaknessGaps   String[] @default([])
  rawSummary     String?  @db.Text
  lastAnalyzed   DateTime @default(now())
  createdAt      DateTime @default(now())

  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([brandProfileId])
  @@map("competitor_insights")
}

enum UserPlan {
  FREE
  PRO
}

model Content {
  id            String          @id @default(uuid())
  title         String
  body          String          @db.Text
  status        ContentStatus   @default(DRAFT)
  contentType   String          @default("general") // blog, ad, product, general
  inputData     Json?           // Store original input parameters
  generatedOutput Json?         // Store structured AI output
  templateId    String?
  userId        String
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      Template?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  versions      ContentVersion[]

  @@index([userId])
  @@index([status])
  @@index([contentType])
  @@index([createdAt])
  @@map("contents")
}

model ContentVersion {
  id              String   @id @default(uuid())
  contentId       String
  versionNumber   Int
  body            String   @db.Text
  improvementType String?  // seo, conversion, clarity, etc.
  scores          Json?    // Store scores for this specific version
  
  createdAt       DateTime @default(now())

  content         Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([versionNumber])
  @@map("content_versions")
}

enum ContentStatus {
  DRAFT
  COMPLETE
}

model Template {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @db.Text
  category    String
  prompt      String   @db.Text
  icon        String?
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contents    Content[]

  @@index([category])
  @@index([isActive])
  @@map("templates")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
